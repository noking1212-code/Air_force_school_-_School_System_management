# Copy this file to .env, then fill in the connection details for ONE database.
# Keep DB_NAME as "gradesphere" when using the supplied schema.sql.

# ------------------------------------------------------------
# OPTION A: Local MySQL
# ------------------------------------------------------------
GRADESPHERE_SECRET=replace-with-a-long-random-value
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gradesphere

# ------------------------------------------------------------
# OPTION B: TiDB Cloud
# To switch to TiDB, replace the five DB_* values above with the
# host, port, username, password and database from TiDB Cloud.
# A common TiDB Cloud SQL port is 4000; use the port shown by your cluster.
# ------------------------------------------------------------
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=3cWJrEGuhsB1wGn.root
# DB_PASSWORD=RfziV4BcFbPqbYsc
# DB_NAME=gradesphere
# FLASK_DEBUG=false

# Flask settings
GRADESPHERE_SECRET=replace_with_a_long_random_value
FLASK_DEBUG=true

# Optional: override the default upload locations.
# By default, uploads are stored under Flask's instance/ directory.
# EXAM_UPLOAD_FOLDER=instance/exam_uploads
# STUDENT_PHOTO_FOLDER=instance/student_photos
